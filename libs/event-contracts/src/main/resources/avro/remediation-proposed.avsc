{
  "type":"record","name":"RemediationProposed","namespace":"com.agilesolutions.commander.contracts.v1",
  "doc":"Candidate action. It must not execute before explicit approval.",
  "fields":[
    {"name":"eventId","type":"string"},{"name":"schemaVersion","type":"string","default":"1.0.0"},
    {"name":"occurredAt","type":"string"},{"name":"incidentId","type":"string"},{"name":"proposalId","type":"string"},
    {"name":"actionType","type":"string","doc":"Allowlisted action identifier, not arbitrary shell or Kubernetes input."},
    {"name":"targetResourceId","type":"string"},{"name":"rationale","type":"string"},{"name":"expectedOutcome","type":"string"},
    {"name":"riskLevel","type":{"type":"enum","name":"RemediationRiskLevel","symbols":["LOW","MEDIUM","HIGH","CRITICAL"]}},
    {"name":"parametersJson","type":"string","doc":"JSON parameters must be validated against an allowlist/schema."},
    {"name":"expiresAt","type":"string"},{"name":"requiresHumanApproval","type":"boolean","default":true},
    {"name":"correlationId","type":"string"},{"name":"causationId","type":["null","string"],"default":null}
  ]
}